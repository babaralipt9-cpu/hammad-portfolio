{
  "builds": [
    { "src": "index.php", "use": "vercel-php@0.9.0" }
  ],
  "routes": [
    {
      "src": "^/data/(.*)",
      "dest": "/index.php",
      "status": 403
    },
    {
      "src": "^/Public/(.*)",
      "dest": "/Public/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/index.php"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options",        "value": "DENY" },
        { "key": "X-XSS-Protection",       "value": "1; mode=block" }
      ]
    }
  ]
}
